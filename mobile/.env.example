# =============================================================================
# Copie para .env.local e preencha. NUNCA versione o arquivo preenchido:
# .env* está no .gitignore (só este .example é versionado).
#
# Regra de ouro: no aplicativo entra APENAS a chave anônima (anon/publishable).
# Ela é pública por definição — quem protege os dados é a RLS, não o segredo.
# A chave service_role NUNCA entra no cliente, nem em EXPO_PUBLIC_*, nem em
# variável de build. Ela vive só no servidor (Edge Function / CI).
# =============================================================================

# URL do projeto Supabase. Região aprovada: South America (São Paulo), sa-east-1.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anônima (publishable). Segura para o cliente.
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# Sem estas duas variáveis o app roda normalmente em modo local-only:
# Hoje, Jornada, progresso, jejum, reflexão e lembrete continuam funcionando,
# e a aba Juntos informa que a conta está indisponível nesta build.
